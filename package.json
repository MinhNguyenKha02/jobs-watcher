{
  "name": "jobs-watcher",
  "version": "1.0.0",
  "description": "Gmail-based job alerts watcher with auto-generated application materials",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npx tsx scripts/prebuild-profile.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --runInBand --detectOpenHandles --forceExit --passWithNoTests",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest tests/unit/ -u --passWithNoTests --coverage --runInBand --detectOpenHandles --forceExit",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest tests/integration/ -u --passWithNoTests --coverage --runInBand --detectOpenHandles --forceExit",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest tests/e2e/ -u --passWithNoTests --coverage --runInBand --detectOpenHandles --forceExit",
    "test:e2e:clean": "CLEAR_GENERATED=1 NODE_OPTIONS='--experimental-vm-modules' jest tests/e2e/ -u --passWithNoTests --coverage --runInBand --detectOpenHandles --forceExit",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch --runInBand --detectOpenHandles --forceExit --passWithNoTests",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "export:e2e": "tsx scripts/export-e2e-output.ts",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "auth": "tsx src/cli/auth.ts",
    "setup": "tsx src/cli/setup.ts",
    "monitor": "tsx src/cli/monitor.ts",
    "stats": "tsx src/cli/monitor.ts stats",
    "logs": "tsx src/cli/monitor.ts logs",
    "pubsub:subscribe": "tsx src/cli/pubsub-subscribe.ts",
    "pubsub:unsubscribe": "tsx src/cli/pubsub-unsubscribe.ts",
    "fetch:raw-emails": "tsx scripts/fetch-raw-emails.ts",
    "analyze:raw-emails": "tsx scripts/analyze-raw-emails.ts",
    "simulate-webhook": "tsx scripts/simulate-webhook.ts",
    "export-fixtures": "tsx scripts/export-fixtures.ts",
    "seed-test-db": "tsx scripts/seed-test-db.ts",
    "phase-2-validate": "bash scripts/phase-2-validate.sh",
    "hash:profile": "tsx scripts/generate-profile-hash.ts",
    "data-listening": "tsx src/cli/data-listening.ts",
    "serve:hybrid": "INGRESS_FIXTURE_MODE=0 CLIPBOARD_FIXTURE_MODE=0 HYBRID_CLIPBOARD_MODE=manual npm run data-listening -- --adapter=hybrid --hybrid-clipboard=manual",
    "clipboard:trigger": "tsx scripts/trigger-hybrid-clipboard.ts",
    "manual-enrichment": "tsx src/cli/manual-enrichment.ts",
    "tui": "tsx src/cli/enhanced-tui.ts",
    "dashboard": "tsx src/cli/dashboard.ts",
    "dashboard:watch": "tsx src/cli/dashboard.ts --watch",
    "feedback-loop": "tsx src/cli/feedback-loop.ts",
    "inspect:db": "tsx scripts/inspect-db.ts",
    "inspect:logs": "tsx scripts/inspect-logs.ts",
    "db:truncate": "SKIP_CONFIRM=1 tsx scripts/db-truncate.ts",
    "env:check": "node -e \"if (!process.env.MONGODB_URI) { console.error('MONGODB_URI is missing'); process.exit(1); } console.log('MONGODB_URI loaded from .env');\"",
    "export:all": "npm run export:e2e && npm run export-fixtures",
    "verify:e2e-output": "tsx scripts/verify-e2e-output.ts",
    "ll:gate:hard": "VERIFY_P0_HARD=1 VERIFY_P1P2_HARD=1 VERIFY_OPERATOR_FRESHNESS=1 OPERATOR_EVIDENCE_MAX_AGE_HOURS=24 npm run verify:e2e-output",
    "ll:human:loop": "npm run manual-enrichment -- --poll-ms=5000",
    "ll:daily:closeout": "bash scripts/long-living-daily-closeout.sh",
    "ll:daily:feedback": "bash scripts/daily-feedback.sh",
    "ll:daily:feedback:baseline": "MAX_SWAP_USED_MB=4608 bash scripts/daily-feedback.sh",
    "ll:daily:feedback:strict": "MAX_SWAP_USED_MB=3072 bash scripts/daily-feedback.sh",
    "ll:daily:feedback:relaxed": "MAX_SWAP_USED_MB=5120 bash scripts/daily-feedback.sh",
    "ll:notify:cases": "bash scripts/ll-notify-latest-cases.sh",
    "ll:scheduled:cycle": "bash scripts/ll-scheduled-cycle.sh",
    "ll:cron:install": "bash scripts/ll-setup-cron.sh",
    "ll:infra:watchdog": "bash scripts/infra-watchdog.sh",
    "ll:infra:autostart": "bash scripts/infra-autostart.sh",
    "ll:infra:monitor": "bash scripts/infra-monitor.sh",
    "ll:infra:stop": "bash scripts/infra-stop.sh",
    "ll:commit:gate": "bash scripts/long-living-commit-gate.sh",
    "ll:fire:verify": "npm run test:e2e && npm run ll:gate:hard",
    "ci:gate": "npm run build && npm run test:unit && npm run test:integration && EXPORT_E2E_OUTPUT=1 npm run test:e2e && npm run export:e2e && npm run ll:gate:hard",
    "integrity:once": "bash -c 'npm run db:truncate && npm run build && npm run test:e2e && npm run export:all && npm run verify:e2e-output && npm run inspect:db && npm run inspect:logs'",
    "feedback-loop:quick": "bash -c 'npm run test:e2e && npm run export:all && npm run inspect:db'",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major"
  },
  "keywords": [
    "gmail",
    "job-alerts",
    "automation",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/pubsub": "^4.3.0",
    "@types/jsdom": "^27.0.0",
    "better-sqlite3": "^9.2.2",
    "clipboardy": "^5.3.1",
    "docx": "^9.5.3",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^131.0.0",
    "handlebars": "^4.7.8",
    "htmlparser2": "^9.1.0",
    "ink": "^4.4.1",
    "jsdom": "^27.4.0",
    "mongodb": "^7.1.0",
    "open": "^10.0.3",
    "puppeteer": "^24.37.3",
    "react": "^18.2.0",
    "zod": "^3.22.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-class-static-block": "^7.21.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-class-static-block": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.28.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "lint-staged": "^16.2.7",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
