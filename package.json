{
  "name": "jobs-watcher",
  "version": "1.0.0",
  "description": "Gmail-based job alerts watcher with auto-generated application materials",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "auth": "tsx src/cli/auth.ts",
    "setup": "tsx src/cli/setup.ts",
    "monitor": "tsx src/cli/monitor.ts",
    "stats": "tsx src/cli/monitor.ts stats",
    "logs": "tsx src/cli/monitor.ts logs",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:e2e": "jest tests/e2e --coverage",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit",
    "format": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "staging:test": "tsx scripts/staging-integration.ts",
    "pubsub:subscribe": "tsx src/cli/pubsub-subscribe.ts",
    "pubsub:unsubscribe": "tsx src/cli/pubsub-unsubscribe.ts"
  },
  "keywords": [
    "gmail",
    "job-alerts",
    "automation",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/pubsub": "^4.3.0",
    "@types/jsdom": "^27.0.0",
    "better-sqlite3": "^9.2.2",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^131.0.0",
    "handlebars": "^4.7.8",
    "htmlparser2": "^9.1.0",
    "ink": "^4.4.1",
    "jsdom": "^27.4.0",
    "open": "^10.0.3",
    "react": "^18.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
