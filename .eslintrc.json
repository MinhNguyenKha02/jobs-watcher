{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "vitest/env": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:import/typescript",
    "plugin:vitest/legacy-recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint",
    "import",
    "vitest"
  ],
  "rules": {
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "import/order": [
      "error",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index"
        ],
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        },
        "newlines-between": "always"
      }
    ],
    "import/no-duplicates": "error",
    "import/no-cycle": "error",
    "import/no-restricted-paths": [
      "error",
      {
        "zones": [
          { "target": "src/domain/**", "from": "src/infrastructure/**", "message": "domain must not import infra" },
          { "target": "src/domain/**", "from": "src/presentation/**", "message": "domain must not import presentation" },
          { "target": "src/domain/**", "from": "src/application/**", "message": "domain must not import application" },
          { "target": "src/application/**", "from": "src/infrastructure/**", "message": "application must not import infra (ports only)" },
          { "target": "src/application/**", "from": "src/presentation/**", "message": "application must not import presentation" },
          { "target": "src/application/ports/**", "from": "src/infrastructure/**", "message": "ports must not import infra" },
          { "target": "src/infrastructure/**", "from": "src/domain/profile/source/**", "message": "infra must not import profile source" },
          { "target": "src/presentation/**", "from": "src/infrastructure/outbound/persistence/**", "message": "presentation must not import persistence" },
          { "target": "src/presentation/**", "from": "src/application/**", "message": "presentation must not import application impl (use TUI ports + state); container wires" }
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/metrics-registry"],
            "importNames": ["DaemonMetricsRegistry", "TuiMetricsRegistry"],
            "message": "use MetricPort from src/application/ports/metrics.port.ts / src/presentation/tui/ports/metrics.port.ts (DIP)"
          },
          {
            "group": ["**/shared-tui-state"],
            "message": "only presentation/tui/components may import shared-tui-state; daemon must not"
          }
        ]
      }
    ],
    "no-var": "error",
    "vitest/no-conditional-expect": "warn",
    "@typescript-eslint/naming-convention": [
      "error",
      {
        "selector": "default",
        "format": [
          "camelCase"
        ],
        "leadingUnderscore": "allow",
        "trailingUnderscore": "allow",
        "filter": {
          "match": false,
          "regex": "__|-|error_type|client_secret|client_id|redirect_uris|access_type|access_token|refresh_token|token_type|expiry_date|^(Signal|Subject|From|To)$"
        }
      },
      {
        "selector": "variable",
        "modifiers": [
          "const"
        ],
        "format": [
          "camelCase",
          "UPPER_CASE"
        ],
        "leadingUnderscore": "allow",
        "filter": {
          "match": false,
          "regex": "__|client_secret|client_id|redirect_uris"
        }
      },
      {
        "selector": "objectLiteralProperty",
        "format": [
          "camelCase",
          "UPPER_CASE"
        ],
        "leadingUnderscore": "allow",
        "filter": {
          "match": false,
          "regex": "-|error_type|access_type"
        }
      },
      {
        "selector": "function",
        "format": [
          "camelCase"
        ],
        "leadingUnderscore": "allow"
      },
      {
        "selector": "import",
        "format": [
          "camelCase",
          "PascalCase"
        ]
      },
      {
        "selector": "parameter",
        "format": [
          "camelCase"
        ],
        "leadingUnderscore": "allow"
      },
      {
        "selector": "typeParameter",
        "format": [
          "PascalCase"
        ]
      },
      {
        "selector": "typeLike",
        "format": [
          "PascalCase"
        ]
      },
      {
        "selector": "enumMember",
        "format": [
          "UPPER_CASE"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/application/container.ts"],
      "rules": {
        "import/no-restricted-paths": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/**/*.{ts,tsx}"
      ],
      "parserOptions": {
        "project": [
          "./tsconfig.json"
        ]
      },
      "rules": {
        "@typescript-eslint/no-explicit-any": "error",
        "@typescript-eslint/no-unsafe-argument": "error",
        "@typescript-eslint/no-unsafe-assignment": "error",
        "@typescript-eslint/no-unsafe-call": "error",
        "@typescript-eslint/no-unsafe-member-access": "error",
        "@typescript-eslint/no-unsafe-return": "error"
      }
    },
    {
      "files": [
        "tests/**/*.{ts,tsx}"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "vitest/valid-describe-callback": "off",
        "@typescript-eslint/naming-convention": [
          "error",
          {
            "selector": "default",
            "format": [
              "camelCase"
            ],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "allow",
            "filter": {
              "match": false,
              "regex": "__|-|error_type|client_secret|client_id|redirect_uris|access_type|access_token|refresh_token|token_type|expiry_date|^(Signal|Subject|From|To)$"
            }
          },
          {
            "selector": "variable",
            "modifiers": [
              "const"
            ],
            "format": [
              "camelCase",
              "UPPER_CASE",
              "PascalCase"
            ],
            "leadingUnderscore": "allow",
            "filter": {
              "match": false,
              "regex": "__|client_secret|client_id|redirect_uris"
            }
          },
          {
            "selector": "objectLiteralProperty",
            "format": [
              "camelCase",
              "UPPER_CASE"
            ],
            "leadingUnderscore": "allow",
            "filter": {
              "match": false,
              "regex": "-|error_type|access_type"
            }
          },
          {
            "selector": "function",
            "format": [
              "camelCase"
            ],
            "leadingUnderscore": "allow"
          },
          {
            "selector": "import",
            "format": [
              "camelCase",
              "PascalCase"
            ]
          },
          {
            "selector": "parameter",
            "format": [
              "camelCase"
            ],
            "leadingUnderscore": "allow"
          },
          {
            "selector": "typeParameter",
            "format": [
              "PascalCase"
            ]
          },
          {
            "selector": "typeLike",
            "format": [
              "PascalCase"
            ]
          },
          {
            "selector": "enumMember",
            "format": [
              "UPPER_CASE"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/domain/profile/**/*.{ts,tsx}",
        "tests/unit/domain/profile/**/*.{ts,tsx}",
        "tests/integration/profile/**/*.{ts,tsx}",
        "tests/regression/profile/**/*.{ts,tsx}",
        "tests/helpers/profile/**/*.{ts,tsx}"
      ],
      "rules": {
        "@typescript-eslint/naming-convention": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unsafe-argument": "off",
        "@typescript-eslint/no-unsafe-assignment": "off",
        "@typescript-eslint/no-unsafe-call": "off",
        "@typescript-eslint/no-unsafe-member-access": "off",
        "@typescript-eslint/no-unsafe-return": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "coverage/",
    "generated/",
    "logs/",
    "cv/",
    "bored-cv-refinement/",
    "bored-cv-refinement/portfolio/landing-page/dist/",
    "bored-cv-refinement/portfolio/landing-page/node_modules/",
    "src/infrastructure/outbound/persistence/json.ts",
    "tests/__fixtures__/emails/sdui.ts"
  ],
  "settings": {
    "import/ignore": [
      "node_modules",
      "\\.d\\.mts$"
    ],
    "import/resolver": {
      "node": {
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx"
        ]
      },
      "typescript": {
        "alwaysTryTypes": true,
        "project": "./tsconfig.json"
      }
    }
  }
}
