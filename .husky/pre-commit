#!/usr/bin/env sh
set -x
. "$(dirname -- "$0")/_/husky.sh"

# Lint staged files (allow console.log for troubleshooting)
npx lint-staged --allow-empty --concurrent false || exit 1
# Type-check
npm run type-check || exit 1
# Run only unit tests for beta stage (update snapshots automatically)
npm run test:unit || exit 1
