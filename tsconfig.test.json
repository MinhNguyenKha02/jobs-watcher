{
  "extends": "./tests/tsconfig.json",
  "include": ["src/**/*", "tests/**/*", "tests/__fixtures__/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests/unit/domain/profile/**",
    "tests/unit/presentation/**",
    "tests/integration/profile/**",
    "tests/integration/presentation/**",
    "tests/helpers/profile/**"
  ],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  }
}