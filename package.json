{
  "name": "jobs-watcher",
  "version": "1.0.0",
  "description": "Gmail-based job alerts watcher with auto-generated application materials",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "auth": "tsx src/cli/auth.ts",
    "setup": "tsx src/cli/setup.ts",
    "monitor": "tsx src/cli/monitor.ts",
    "stats": "tsx src/cli/monitor.ts stats",
    "logs": "tsx src/cli/monitor.ts logs",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:e2e": "jest tests/e2e --coverage",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit && eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pubsub:subscribe": "tsx src/cli/pubsub-subscribe.ts",
    "pubsub:unsubscribe": "tsx src/cli/pubsub-unsubscribe.ts",
    "fetch:raw-emails": "tsx scripts/fetch-raw-emails.ts",
    "analyze:raw-emails": "tsx scripts/analyze-raw-emails.ts",
    "simulate-webhook": "tsx scripts/simulate-webhook.ts",
    "export-fixtures": "tsx scripts/export-fixtures.ts",
    "seed-test-db": "tsx scripts/seed-test-db.ts",
    "phase-2-validate": "bash scripts/phase-2-validate.sh",
    "hash:profile": "tsx scripts/generate-profile-hash.ts",
    "data-testing": "OPERATIONAL_MODE=data-testing DATA_SOURCE_TYPE=db tsx src/cli/data-testing.ts",
    "data-testing:no-browser": "AUTO_OPEN_BROWSER=false OPERATIONAL_MODE=data-testing DATA_SOURCE_TYPE=db tsx src/cli/data-testing.ts",
    "data-listening": "OPERATIONAL_MODE=data-listening DATA_SOURCE_TYPE=webhook tsx src/cli/data-listening.ts",
    "prepare": "husky install"
  },
  "keywords": [
    "gmail",
    "job-alerts",
    "automation",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/pubsub": "^4.3.0",
    "@types/jsdom": "^27.0.0",
    "better-sqlite3": "^9.2.2",
    "docx": "^9.5.3",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^131.0.0",
    "handlebars": "^4.7.8",
    "htmlparser2": "^9.1.0",
    "ink": "^4.4.1",
    "jsdom": "^27.4.0",
    "mongodb": "^7.1.0",
    "open": "^10.0.3",
    "puppeteer": "^24.37.3",
    "react": "^18.2.0",
    "zod": "^3.22.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-class-static-block": "^7.21.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-class-static-block": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.28.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.6.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "lint-staged": "^16.2.7",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
