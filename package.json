{
  "name": "jobs-watcher",
  "version": "7.2.0",
  "description": "Gmail-based job alerts watcher with auto-generated application materials",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "npx tsx scripts/prebuild-profile.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "test": "vitest --passWithNoTests",
    "test:unit": "vitest tests/unit/ -u --passWithNoTests",
    "test:integration": "vitest tests/integration/ -u --passWithNoTests",
    "test:e2e": "TEST_NO_GMAIL_AUTH=1 INTERNAL_AUTH_TOKEN=e2e-internal-token vitest tests/e2e/ -u --passWithNoTests",
    "test:e2e:core": "npm run test:e2e -- --testPathPattern=full-integration-e2e.test.ts",
    "test:e2e:clean": "CLEAR_GENERATED=1 TEST_NO_GMAIL_AUTH=1 INTERNAL_AUTH_TOKEN=e2e-internal-token vitest tests/e2e/ -u --passWithNoTests",
    "test:watch": "vitest --watch --passWithNoTests",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "auth": "tsx src/cli/auth.ts",
    "setup": "tsx src/cli/setup.ts",
    "pubsub:subscribe": "tsx src/cli/pubsub-subscribe.ts",
    "pubsub:unsubscribe": "tsx src/cli/pubsub-unsubscribe.ts",
    "render-server": "tsx src/presentation/tui/tui-stdout-adapter.ts",
    "action-controller": "tsx src/presentation/tui/tui-stdin-adapter.ts",
    "eval:fetch-and-trigger": "bash scripts/eval-fetch-and-trigger.sh",
    "db:truncate": "SKIP_CONFIRM=1 tsx scripts/db-truncate.ts",
    "build:artifacts": "tsx src/artifacts/build-artifacts.ts",
    "test:regression": "vitest tests/regression/ -u --passWithNoTests"
  },
  "keywords": [
    "gmail",
    "job-alerts",
    "automation",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/pubsub": "^4.3.0",
    "amqplib": "^2.0.1",
    "cheerio": "^1.2.0",
    "clipboardy": "^5.3.1",
    "dotenv": "^16.3.1",
    "eventsource": "^2.0.0",
    "express": "^4.18.2",
    "googleapis": "^131.0.0",
    "handlebars": "^4.7.8",
    "mongodb": "^7.1.0",
    "open": "^10.0.3",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "playwright-extra": "^4.3.6",
    "prom-client": "^15.1.3",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.22.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.7",
    "mongodb-memory-server": "^11.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.1"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
