{
  "env": {
    "node": true,
    "es2022": true,
    "vitest": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:import/typescript",
    "plugin:vitest/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint",
    "react",
    "react-hooks",
    "import",
    "vitest"
  ],
  "rules": {
    "@typescript-eslint/explicit-function-return-types": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/order": [
      "warn",
      {
        "groups": [
          "builtin",
          "external",
          "internal",
          "parent",
          "sibling",
          "index"
        ],
        "alphabetize": {
          "order": "asc",
          "caseInsensitive": true
        },
        "newlines-between": "always"
      }
    ],
    "no-console": [
      "off"
    ],
    "prefer-const": "warn",
    "no-constant-condition": "warn",
    "no-useless-escape": "warn",
    "react/no-unescaped-entities": "warn",
    "vitest/no-conditional-expect": "warn",
    "import/no-duplicates": "warn",
    "react/react-in-jsx-scope": "off",
    "react/prop-types": "off"
  },
  "ignorePatterns": [
    "coverage/",
    "generated/",
    "logs/",
    "cv/",
    "bored-cv-refinement/",
    "bored-cv-refinement/portfolio/landing-page/dist/",
    "bored-cv-refinement/portfolio/landing-page/node_modules/"
  ],
  "settings": {
    "react": {
      "version": "detect"
    },
    "import/ignore": [
      "node_modules",
      "\\.d\\.mts$"
    ],
    "import/resolver": {
      "node": {
        "extensions": [
          ".js",
          ".jsx",
          ".ts",
          ".tsx"
        ]
      },
      "typescript": {
        "alwaysTryTypes": true,
        "project": "./tsconfig.json"
      }
    }
  }
}
