[Unit]
Description=Jobs Watcher webhook + worker
After=network.target mongod.service rabbitmq-server.service
Wants=network-online.target rabbitmq-server.service mongod.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
User=jobs-watcher
Group=jobs-watcher
EnvironmentFile=/etc/jobs-watcher.env
Environment="NODE_ENV=production"
WorkingDirectory=/opt/jobs-watcher
ExecStart=/opt/jobs-watcher/.nvm/versions/node/v22.12.0/bin/node /opt/jobs-watcher/dist/src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0027
RuntimeDirectory=jobs-watcher
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=restart

[Install]
WantedBy=multi-user.target
