# Copy to .env (dev) or .env.production (prod) and fill secrets.
# Dev: UDS/IPC = XDG runtime (/run/user/1000). Prod: /run/jobs-watcher.

# Environment
NODE_ENV=development

# Gmail API — https://console.cloud.google.com
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_LABEL_NAME=Job-Alerts
GMAIL_TOPIC_NAME=projects/your-project/topics/your-topic

# Webhook
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhook/gmail

# Health — localhost-only (health-adapter/webhook-adapter bind 127.0.0.1, was *:9090/*:9091/*:3000)
HEALTH_HOST=127.0.0.1
HEALTH_PORT=9090
TUI_HEALTH_HOST=127.0.0.1
TUI_HEALTH_PORT=9091
WEBHOOK_HOST=127.0.0.1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=jobs_watcher

# RabbitMQ
RABBITMQ_URL=amqp://localhost
RABBITMQ_EXCHANGE=jobs.events

# Auth (internal UDS token — same value for INTERNAL_AUTH_TOKEN and UDS_TOKEN)
INTERNAL_AUTH_TOKEN=replace-me-internal-token
UDS_TOKEN=replace-me-internal-token

# UDS / IPC — single source, no fallback inline
# Dev:
UDS_SOCKET_PATH=/run/user/1000/jobs-watcher-ingest.sock
TUI_SHARED_STATE_PATH=/run/user/1000/jobs-watcher-tui-state.json
# Prod (in .env.production):
# UDS_SOCKET_PATH=/run/jobs-watcher/ingest.sock
# TUI_SHARED_STATE_PATH=/run/jobs-watcher/tui-state.json

# Asset
ASSET_OUTPUT_DIR=./assets
# Prod: ASSET_OUTPUT_DIR=/srv/jobs-watcher/asset

# Feature / Infra (optional, see src/config.ts + scripts)
# P1_QUEUE_LAG_MAX_MS=300000
# INFRA_PROFILE=i5_10th_16g_zram_swapfile
# MAX_SWAP_USED_MB=4608
