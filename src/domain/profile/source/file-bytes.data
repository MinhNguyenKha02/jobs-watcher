    },
    testing: {
    },
    database: {

    },
    observability: {

    }
    // ... from profile.source.ts and profile.source.types.ts
  },
  comp: {
    //... from profile.source.ts and profile.source.types.ts
  },
  beh: {
    //... from profile.source.ts and profile.source.types.ts
  },
  tech: {
    //... from profile.source.ts and profile.source.types.ts
  },
} as const satisfies RelationsSource;