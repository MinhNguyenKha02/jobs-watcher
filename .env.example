# Example environment variables for local development
# Copy to .env and fill secrets before running.
INTERNAL_AUTH_TOKEN=replace-me-internal-token
MONGODB_URI=mongodb://localhost:27017/jobs-watcher
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-google-refresh-token
WEBHOOK_PORT=3000
HEALTH_PORT=3001
START_DATA_LISTENING=0
INGEST_SOCKET_PATH=/var/run/jobs-watcher.sock
# Gmail OAuth Configuration
# Get these from: https://console.cloud.google.com
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback

# Gmail Configuration
GMAIL_LABEL_NAME=Job Alerts
GMAIL_TOPIC_NAME=your_pubsub_topic_name

# Webhook Configuration
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhook/gmail

# Database & Resources
DATABASE_PATH=./data/jobs.db
RESOURCES_PATH=./resources
TEMPLATES_PATH=./templates
LOGS_PATH=./logs

# Environment
NODE_ENV=development
DEBUG=false

# Feature Flags
FEATURE_TUI=true
FEATURE_NOTIFICATIONS=true
FEATURE_LOGGING=true

# ============================================================================
# Long-Living Service Governance & Policy Configuration
# ============================================================================

# Ingress Fixture Mode (0=real, 1=fixture)
# POLICY: Must be 0 in production to prevent test fixture leakage
# Set to 1 only for testing with fixture emails
INGRESS_FIXTURE_MODE=0

# Clipboard Fixture Mode (0=real, 1=fixture)
# Set to 0 in production to use real clipboard
# Set to 1 only for testing with fixture clipboard data
CLIPBOARD_FIXTURE_MODE=0

# P1 Queue Lag Maximum Threshold (milliseconds)
# POLICY: Default 300000ms (5 minutes) - Hard gate fails if exceeded
# Used by: ll:gate:hard, ll:commit:gate, ci:gate verification scripts
P1_QUEUE_LAG_MAX_MS=300000

# Infra Runtime Profile (bash-only monitor/supervisor)
# Recommended for i5 10th-gen, 16GiB RAM, zRAM + ~10GiB swapfile, NVMe:
# - Keep swappiness at OS level (e.g. 15) if already tuned for multitask.
# - Do NOT force swap reduction in app policy.
# - Use swap threshold policy to avoid false HOLD while preserving incident detection.
INFRA_PROFILE=i5_10th_16g_zram_swapfile

# Daily feedback infra thresholds (CASE generation)
# CASE_INFRA_SWAP_PRESSURE fires when SWAP_USED_MB > MAX_SWAP_USED_MB.
# Set to 4608MB baseline for above profile; raise only with explicit runbook decision.
MAX_SWAP_USED_MB=4608

# Disk and process safety guardrails
MAX_DISK_PERCENT=90
MAX_SERVICE_PROCS=1
MAX_RESTARTS_DAILY=5

# CPU threshold is monitor-only today (logged, not converted to CASE gate).
MAX_CPU_PERCENT=95

# 24/7 Infra Watchdog (desktop notify + automatic fallback)
# - warning: throttles core pipeline via renice/ionice
# - critical: graceful stop -> force kill fallback -> cooldown sleep -> supervisor recover
WATCHDOG_INTERVAL_SEC=20
WATCHDOG_WARN_CONSECUTIVE=2
WATCHDOG_CRIT_CONSECUTIVE=4
WATCHDOG_SOFT_COOLDOWN_SEC=180
WATCHDOG_KILL_GRACE_SEC=8
WATCHDOG_CPU_WARN_PERCENT=90
WATCHDOG_CPU_CRIT_PERCENT=95

# Hard Gate Verification Flags (0=disabled, 1=enabled)
# POLICY: Hard fail - blocks commit/promotion immediately on gate failure
# Set to 1 to enforce P0/P1/P2 gates during verification
VERIFY_P0_HARD=1
VERIFY_P1P2_HARD=1

# Alert Routing Strategy
# POLICY: webhook + email + log (most comprehensive)
# P1 gates validate evidence for alert routing in action_log with:
#   - action: alert_routed_desktop / alert_routed_webhook / alert_routed_email
#   - details.channel: desktop / webhook / email
# System automatically validates all configured channels
