[Unit]
Description=Jobs Watcher fetch weekly 500/7d
After=jobs-watcher.service network-online.target
Wants=jobs-watcher.service network-online.target

[Service]
Type=oneshot
User=jobs-watcher
Group=jobs-watcher
WorkingDirectory=/opt/jobs-watcher
EnvironmentFile=/etc/jobs-watcher.env
ExecStart=/bin/bash /opt/jobs-watcher/scripts/eval-fetch-and-trigger.sh 500 7
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=timers.target
